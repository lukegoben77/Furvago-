{%- assign cart_product = all_products[settings.product_handle] -%}
{%- assign cvcd_any = false -%}
<script type="application/json" id="CartVariantCompareData">
{
  {%- for v in cart_product.variants -%}
    {%- if cvcd_any %},{% endif -%}"{{ v.id }}": {{ v.compare_at_price | default: 0 }}
    {%- assign cvcd_any = true -%}
  {%- endfor -%}
  {%- if product -%}
    {%- for v in product.variants -%}
      {%- if cvcd_any %},{% endif -%}"{{ v.id }}": {{ v.compare_at_price | default: 0 }}
      {%- assign cvcd_any = true -%}
    {%- endfor -%}
  {%- endif -%}
  {%- for item in cart.items -%}
    {%- if cvcd_any %},{% endif -%}"{{ item.variant_id }}": {{ item.variant.compare_at_price | default: 0 }}
    {%- assign cvcd_any = true -%}
  {%- endfor -%}
}
</script>
<div class="scrim" id="scrim"></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="Shopping cart" aria-hidden="true">
  <div class="cart-logo">
    <img src="{{ 'logo-light.png' | asset_url }}" alt="{{ shop.name }}" width="720" height="169" />
  </div>
  <div class="cart-head">
    <h3>Your cart</h3>
    <button class="cart-close" id="cartClose" aria-label="Close cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </div>
  <div class="cart-body" id="cartBody">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg><p>Your cart is empty.</p></div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-line">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 260 }}" alt="" />
          {%- else -%}
            <img src="{{ 'thumb-black.jpg' | asset_url }}" alt="" />
          {%- endif -%}
          <div class="cl-info">
            <div class="cl-name">{{ item.product.title }}</div>
            <div class="cl-variant">{{ item.variant.title }}</div>
            <div class="cl-qty">
              <button data-act="dec" data-line="{{ forloop.index }}" aria-label="Decrease">–</button>
              <span>{{ item.quantity }}</span>
              <button data-act="inc" data-line="{{ forloop.index }}" aria-label="Increase">+</button>
            </div>
          </div>
          <div class="cl-price">
            {%- if item.variant.compare_at_price > item.variant.price -%}
              <del class="cl-compare">{{ item.variant.compare_at_price | times: item.quantity | money }}</del>
            {%- endif -%}
            <span class="cl-current">{{ item.final_line_price | money }}</span>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <div class="cart-foot">
    <div class="cart-subtotal"><span class="lbl">Subtotal</span><span class="val" id="cartSubtotal">{{ cart.total_price | money }}</span></div>
    <p class="cart-note">Shipping &amp; taxes calculated at checkout.</p>
    <button class="btn btn-dark btn-block" id="checkoutBtn">Checkout</button>
    <div class="cart-trust">
      <div class="r">{% render 'icon', name: 'truck', width: '1.3' %}<span>Free shipping</span></div>
      <div class="r">{% render 'icon', name: 'shield-check', width: '1.3' %}<span>30-day returns</span></div>
      <div class="r">{% render 'icon', name: 'lock', width: '1.3' %}<span>Secure checkout</span></div>
    </div>
  </div>
</aside>
