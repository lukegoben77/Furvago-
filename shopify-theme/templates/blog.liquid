<header class="page-hero">
  <div class="wrap">
    <p class="eyebrow">Journal</p>
    <h1>{{ blog.title }}</h1>
  </div>
</header>
<section style="padding-top:0;">
  <div class="wrap" style="max-width:52rem;display:grid;gap:1.5rem;">
    {% for article in blog.articles %}
      <a href="{{ article.url }}" style="color:inherit;text-decoration:none;">
        <h3>{{ article.title }}</h3>
        <p style="color:var(--ink-soft);">{{ article.published_at | date: '%B %d, %Y' }}</p>
      </a>
    {% else %}
      <p style="color:var(--ink-soft);">No posts yet.</p>
    {% endfor %}
  </div>
</section>
