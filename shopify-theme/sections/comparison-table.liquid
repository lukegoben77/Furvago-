<section>
  <div class="wrap" style="max-width:48rem;">
    <div class="compare-head reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subhead }}</p>
    </div>
    <div class="compare-wrap reveal">
      <table class="compare-table">
        <thead>
          <tr>
            <th></th>
            <th class="col-furvago">{{ section.settings.col_brand }}</th>
            <th>{{ section.settings.col_other }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.label }}</td>
              <td class="col-furvago">{% if block.settings.brand_value == blank %}<span class="check">✓</span>{% else %}{{ block.settings.brand_value }}{% endif %}</td>
              <td class="muted">{{ block.settings.other_value }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not All Calming Vests Are the Same." },
    { "type": "text", "id": "subhead", "label": "Subhead (italic)", "default": "Here's why it matters." },
    { "type": "text", "id": "col_brand", "label": "Brand column header", "default": "Furvago" },
    { "type": "text", "id": "col_other", "label": "Other column header", "default": "Generic Vest" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Free shipping" },
        { "type": "text", "id": "brand_value", "label": "Brand value (leave blank for a checkmark)" },
        { "type": "text", "id": "other_value", "label": "Other value", "default": "Varies" }
      ]
    }
  ],
  "presets": [ { "name": "Comparison table" } ]
}
{% endschema %}
