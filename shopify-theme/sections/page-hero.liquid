<header class="page-hero">
  <div class="wrap">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ page.title }}{% endif %}</h1>
    {%- if section.settings.lead != blank -%}
      <p class="lead">{{ section.settings.lead }}</p>
    {%- endif -%}
  </div>
</header>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading (falls back to the page title)" },
    { "type": "textarea", "id": "lead", "label": "Lead" }
  ],
  "presets": [ { "name": "Page hero" } ]
}
{% endschema %}
