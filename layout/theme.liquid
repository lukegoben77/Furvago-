<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">

  {{ content_for_header }}

  <link rel="preload" href="{{ 'bricolage.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ 'intertight.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <noscript><style>.reveal{opacity:1!important;transform:none!important}.cart-drawer,.scrim,.sticky-atc{display:none!important}</style></noscript>

  <script>
    window.theme = {
      moneyFormat: {{ shop.money_format | json }},
      cartUrl: {{ routes.cart_url | json }},
      cartAddUrl: {{ routes.cart_add_url | json }},
      cartChangeUrl: {{ routes.cart_change_url | json }}
    };
  </script>
</head>
<body class="template-{{ template.name | handleize }}">

  <a class="skip-link" href="#main">Skip to content</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
