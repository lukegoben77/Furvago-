<section>
  <div class="wrap">
    <div class="section-head reveal">
      <div class="reviews-heading">
        {%- if section.settings.show_rating -%}
          {%- render 'star-rating', rating: section.settings.rating_value -%}
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <p class="note">{% if section.settings.tag != blank %}<span class="placeholder-tag">{{ section.settings.tag }}</span>{% else %}{{ section.settings.note }}{% endif %}</p>
    </div>
    <div class="review-strip reveal">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-stars" aria-label="{{ block.settings.stars }} out of 5">
            {%- for i in (1..block.settings.stars) -%}
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.5 1.6 6.7L12 17l-6.2 3.6 1.6-6.7L2.2 8.9l6.9-.6z"/></svg>
            {%- endfor -%}
          </div>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <p class="review-byline">{{ block.settings.byline }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What early owners say." },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating above the heading", "default": true },
    { "type": "number", "id": "rating_value", "label": "Rating value", "default": 4.9 },
    { "type": "text", "id": "tag", "label": "Placeholder tag (clear when reviews are real)", "default": "Placeholder reviews — replace before launch" },
    { "type": "text", "id": "note", "label": "Note (shown when tag is empty)" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "\"Write the review here.\"" },
        { "type": "text", "id": "byline", "label": "Byline", "default": "Placeholder review" }
      ]
    }
  ],
  "presets": [ { "name": "Reviews" } ]
}
{% endschema %}
