<section id="pdp-reviews">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="reviews-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <p class="note">{% if section.settings.tag != blank %}<span class="placeholder-tag">{{ section.settings.tag }}</span>{% else %}{{ section.settings.note }}{% endif %}</p>
    </div>
    <div class="review-strip reveal" data-carousel="dots-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img class="review-photo" src="{{ block.settings.image | image_url: width: 600 }}" alt="" width="600" height="600" loading="lazy">
          {%- endif -%}
          <div class="review-meta">
            <div class="review-who">
              <span class="review-byline">{{ block.settings.byline }}</span>
              {%- if block.settings.location != blank -%}<span class="review-location">{{ block.settings.location }}</span>{%- endif -%}
            </div>
            <div class="review-meta-right">
              {%- if block.settings.date != blank -%}<span class="review-date">{{ block.settings.date }}</span>{%- endif -%}
              {%- if block.settings.verified -%}
                <span class="review-verified">{% render 'icon', name: 'shield-check', width: '0.85' %}Verified</span>
              {%- endif -%}
            </div>
          </div>
          <div class="review-stars" aria-label="{{ block.settings.stars }} out of 5">
            {%- for i in (1..block.settings.stars) -%}
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.5 1.6 6.7L12 17l-6.2 3.6 1.6-6.7L2.2 8.9l6.9-.6z"/></svg>
            {%- endfor -%}
          </div>
          <blockquote>{{ block.settings.quote }}</blockquote>
        </div>
      {%- endfor -%}
    </div>
    <div class="carousel-dots" id="dots-{{ section.id }}"></div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What early owners say." },
    { "type": "text", "id": "tag", "label": "Placeholder tag (clear when reviews are real)", "default": "Placeholder reviews — replace before launch" },
    { "type": "text", "id": "note", "label": "Note (shown when tag is empty)" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "\"Write the review here.\"" },
        { "type": "text", "id": "byline", "label": "Byline", "default": "Placeholder review" },
        { "type": "text", "id": "location", "label": "Location (optional)", "info": "e.g. Austin, TX" },
        { "type": "text", "id": "date", "label": "Date (optional)", "info": "e.g. \"2 weeks ago\" or \"June 2026\"" },
        { "type": "checkbox", "id": "verified", "label": "Show \"Verified\" badge", "default": false },
        { "type": "image_picker", "id": "image", "label": "Product photo (optional)", "info": "Shows above the review text on this card." }
      ]
    }
  ],
  "presets": [ { "name": "Reviews" } ]
}
{% endschema %}
