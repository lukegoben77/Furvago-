<section>
  <div class="cta-band reveal">
    <div class="cta-band-inner">
      <p class="eyebrow" style="justify-content:center;">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Give them somewhere safe to go" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The next storm is coming. Be ready for it." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Free shipping, a 30-day return window, and a vest built to help your dog through the nights that scare them most." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the vest" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "CTA band" } ]
}
{% endschema %}
