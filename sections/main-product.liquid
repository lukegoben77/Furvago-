{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign has_compare = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}{%- assign has_compare = true -%}{%- endif -%}

<section class="pdp">
  <div class="wrap pdp-grid">
    <div class="gallery">
      <div class="gallery-main" id="galleryMain">
        {%- if product.images.size > 0 -%}
          {%- for image in product.images -%}
            <img data-position="{{ image.position }}" data-variant-ids="{{ image.variant_ids | join: ',' }}" src="{{ image | image_url: width: 1000 }}" alt="{{ image.alt | default: product.title | escape }}" width="1000" height="1000" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} />
          {%- endfor -%}
        {%- else -%}
          <img src="{{ 'product-black.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="1000" height="1000" fetchpriority="high" />
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="gallery-dots" id="dots-gallery" role="tablist" aria-label="Product images"></div>
      {%- endif -%}
    </div>

    <div class="pdp-info">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.show_rating -%}
        <a id="pdpRatingLink" class="pdp-rating-link" aria-label="Jump to reviews">
          {%- render 'star-rating', rating: section.settings.rating_value, count: product.metafields.reviews.rating_count.value -%}
        </a>
      {%- endif -%}
      <h1>{{ product.title }}</h1>
      {%- if section.settings.hook != blank -%}
        <p class="pdp-hook">{{ section.settings.hook }}</p>
      {%- endif -%}
      {%- if section.settings.subhead != blank -%}
        <p style="color:var(--ink-soft);font-size:1rem;margin-top:0.6rem;line-height:1.5;">{{ section.settings.subhead }}</p>
      {%- endif -%}
      <div class="pdp-price">
        <span id="priceCurrent">{{ current_variant.price | money }}</span>
        <del id="priceCompare"{% unless has_compare %} style="display:none;"{% endunless %}>{{ current_variant.compare_at_price | money }}</del>
        <span class="save" id="priceSave"{% unless has_compare %} style="display:none;"{% endunless %}>
          {%- if has_compare -%}
            {%- assign save_amount = current_variant.compare_at_price | minus: current_variant.price -%}
            Save {{ save_amount | money_without_trailing_zeros }}
          {%- endif -%}
        </span>
      </div>

      <div data-selected-options='{{ current_variant.options | json }}'>
        {%- for option in product.options_with_values -%}
          {%- assign opt_name_down = option.name | downcase -%}
          <div class="opt-group">
            <div class="opt-label">
              <span>{{ option.name }}{% if opt_name_down == 'color' or opt_name_down == 'colour' %} — <span id="colorName" data-option-name="{{ forloop.index }}">{{ option.selected_value }}</span>{% endif %}</span>
              {%- if opt_name_down == 'size' -%}<a id="openSizeGuide">Size guide</a>{%- endif -%}
            </div>
            {%- if opt_name_down == 'color' or opt_name_down == 'colour' -%}
              {%- assign opt_index = option.position | minus: 1 -%}
              <div class="swatches" id="swatches">
                {%- for value in option.values -%}
                  {%- assign swatch_image = blank -%}
                  {%- for v in product.variants -%}
                    {%- assign v_color = v.options[opt_index] -%}
                    {%- if swatch_image == blank and v_color == value and v.featured_image -%}
                      {%- assign swatch_image = v.featured_image -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign swatch_key = value | handleize -%}
                  {%- assign swatch_position = 'center' -%}
                  {%- case swatch_key -%}
                    {%- when 'charcoal', 'dark-gray', 'dark-grey' -%}{%- assign swatch_fallback = '#3a3a3c' -%}
                    {%- when 'rose', 'magenta' -%}{%- assign swatch_fallback = '#a83b63' -%}
                    {%- when 'navy' -%}{%- assign swatch_fallback = '#2f3a63' -%}
                    {%- when 'gray', 'grey' -%}{%- assign swatch_fallback = value | downcase -%}{%- assign swatch_position = section.settings.gray_swatch_position | default: 'center 55%' -%}
                    {%- else -%}{%- assign swatch_fallback = value | downcase -%}
                  {%- endcase -%}
                  <button type="button" class="swatch{% if value == option.selected_value %} active{% endif %}" data-option-button data-option-pos="{{ forloop.parentloop.index }}" data-value="{{ value | escape }}" data-color="{{ swatch_key }}" aria-label="{{ value | escape }}"{% if swatch_image != blank %} style="background-image:url('{{ swatch_image | image_url: width: 120 }}');background-position:{{ swatch_position }};"{% else %} style="background-color:{{ swatch_fallback }};"{% endif %}></button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="sizes"{% if opt_name_down == 'size' %} id="sizes"{% endif %}>
                {%- for value in option.values -%}
                  <button type="button" class="size-btn{% if value == option.selected_value %} active{% endif %}" data-option-button data-option-pos="{{ forloop.parentloop.index }}" data-value="{{ value | escape }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <form method="post" action="{{ routes.cart_add_url }}" id="productForm" class="atc-row">
        <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}">
        <button type="submit" class="btn btn-primary" id="addToCart"{% unless current_variant.available %} disabled{% endunless %}>
          {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </button>
      </form>

      <div class="pdp-reassure">
        {%- for block in section.blocks -%}
          {%- if block.type == 'reassure' -%}
            <div class="r" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}{{ block.settings.text }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="acc" id="pdpHeroAcc" style="margin-top:1.6rem;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <div class="acc-item" {{ block.shopify_attributes }}>
              <button class="acc-q">{{ block.settings.title }}<span class="ic"></span></button>
              <div class="acc-a"><p>{{ block.settings.content | remove: '<p>' | remove: '</p>' }}
                {%- if block.settings.link_label != blank %} <a href="{{ block.settings.link_url | default: routes.root_url }}">{{ block.settings.link_label }}</a>{% endif -%}
                {%- if block.settings.show_size_jump %} <button type="button" id="jumpSizeGuideAcc" class="acc-jump">Jump to the full size guide ↓</button>{% endif -%}
              </p></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<div class="sticky-atc" id="stickyAtc">
  <div class="sa-info"><span class="sa-name">{{ product.title }}</span><span class="sa-price">{{ current_variant.price | money }} · {{ current_variant.title | replace: ' / ', ' · ' }}</span></div>
  <button class="btn btn-primary" id="stickyAdd">Add to cart</button>
</div>

<script type="application/json" id="ProductJson">{{ product | json }}</script>

{% schema %}
{
  "name": "Product hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Furvago — the calming vest" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating above the title", "default": true },
    { "type": "number", "id": "rating_value", "label": "Rating value", "default": 4.9 },
    { "type": "text", "id": "hook", "label": "Hook line (italic)", "default": "The first time you put it on, watch their shoulders drop." },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Built for the exact moments that undo them — the thunder rolling in, the fireworks starting, the click of the door as you leave." },
    { "type": "text", "id": "gray_swatch_position", "label": "Gray swatch photo focal point (CSS background-position)", "info": "Nudge this if the Gray color swatch crops awkwardly. Lower percentage moves the visible crop up (toward the head), higher moves it down (toward the vest/body). e.g. \"center 40%\" or \"center 65%\".", "default": "center 55%" }
  ],
  "blocks": [
    {
      "type": "reassure",
      "name": "Trust row line",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Shipping truck" },
          { "value": "returns", "label": "Return arrow" },
          { "value": "calendar", "label": "Calendar" },
          { "value": "pin", "label": "Teardrop" },
          { "value": "check", "label": "Checkmark" }
        ], "default": "truck" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product Description" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Describe the product here.</p>" },
        { "type": "text", "id": "link_label", "label": "Trailing link label (optional)" },
        { "type": "url", "id": "link_url", "label": "Trailing link URL" },
        { "type": "checkbox", "id": "show_size_jump", "label": "Show \"Jump to the full size guide\" button", "default": false }
      ]
    }
  ]
}
{% endschema %}
