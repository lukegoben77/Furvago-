<section>
  <div class="wrap expect-grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 style="margin-top:0.6rem;">{{ section.settings.heading }}</h2>
      <p style="color:var(--ink-soft);margin-top:1.1rem;font-size:1.03rem;line-height:1.6;">{{ section.settings.intro }}</p>
    </div>
    <div>
      <ul class="expect-list" data-carousel="dots-{{ section.id }}">
        {%- for block in section.blocks -%}
          <li class="expect-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <div class="expect-media"><img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" /></div>
            {%- else -%}
              <div class="expect-media {{ block.settings.tone }}"><svg class="motif" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% case block.settings.motif %}{% when 'pin' %}<path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/>{% when 'calm-face' %}<path d="M4 15c2-1 4-1 6 0s4 1 6 0 4-1 6 0"/><circle cx="9" cy="9" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="9" r="1" fill="currentColor" stroke="none"/>{% else %}<path d="M12 20s-6-4-6-9a4 4 0 0 1 6-3.5A4 4 0 0 1 18 11c0 5-6 9-6 9z"/>{% endcase %}</svg></div>
            {%- endif -%}
            <div class="card-copy">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
              {%- if block.settings.pill != blank -%}<span class="card-pill">{{ block.settings.pill }}</span>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="carousel-dots" id="dots-{{ section.id }}"></div>
      {%- if section.settings.note != blank -%}
        <p class="expect-note">{{ section.settings.note }}</p>
      {%- endif -%}
      {%- if section.settings.closing != blank -%}
        <p class="carousel-closing">{{ section.settings.closing }}</p>
      {%- endif -%}
      {%- if section.settings.show_atc -%}
        <div style="text-align:center;margin-top:1.6rem;">
          <button class="btn btn-primary" id="addToCartExpect">Add to cart</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "What to expect",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What to expect" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "It's not always instant." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Some dogs settle within the first few minutes." },
    { "type": "text", "id": "note", "label": "Dashed note box", "default": "If your dog seems more distressed in the vest — not less — take it off and talk to your vet before trying again." },
    { "type": "text", "id": "closing", "label": "Closing line", "default": "Every dog settles differently — but they don't have to do it alone." },
    { "type": "checkbox", "id": "show_atc", "label": "Show Add to cart button", "default": true }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (replaces mood panel)" },
        { "type": "select", "id": "tone", "label": "Mood tone", "options": [
          { "value": "tone-a", "label": "Deep olive" },
          { "value": "tone-b", "label": "Warm brown" },
          { "value": "tone-c", "label": "Clay pink" }
        ], "default": "tone-a" },
        { "type": "select", "id": "motif", "label": "Mood icon", "options": [
          { "value": "pin", "label": "Teardrop" },
          { "value": "calm-face", "label": "Calm face" },
          { "value": "heart", "label": "Heart" }
        ], "default": "pin" },
        { "type": "text", "id": "title", "label": "Headline", "default": "A tail that drops and softens" },
        { "type": "text", "id": "text", "label": "Body", "default": "Instead of staying tucked or stiff." },
        { "type": "text", "id": "pill", "label": "Pill badge", "default": "First sign of calm" }
      ]
    }
  ],
  "presets": [ { "name": "What to expect" } ]
}
{% endschema %}
