<section>
  <div class="cta-band reveal" style="text-align:left;">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="margin-bottom:0.4rem;">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 style="margin-bottom:2rem;">{{ section.settings.heading }}</h2>
    <div class="step-grid" data-carousel="dots-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="step-card" {{ block.shopify_attributes }}>
          <div class="step-visual">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy" />
            {%- else -%}
              <span class="step-emoji" role="img" aria-label="{{ block.settings.title | escape }}">{{ block.settings.emoji }}</span>
            {%- endif -%}
          </div>
          <div class="card-copy">
            <span class="step-num">{{ forloop.index }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            {%- if block.settings.pill != blank -%}<span class="card-pill">{{ block.settings.pill }}</span>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="carousel-dots" id="dots-{{ section.id }}"></div>
    {%- if section.settings.closing != blank -%}
      <p class="carousel-closing on-dark">{{ section.settings.closing }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How to use steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In practice" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to put it on — and when." },
    { "type": "text", "id": "closing", "label": "Closing line", "default": "Three minutes of prep, and they're ready for whatever's coming." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (replaces the emoji below if set)" },
        { "type": "text", "id": "emoji", "label": "Emoji (used if no photo is chosen)", "info": "Paste any emoji — shown large above the step text.", "default": "🐕‍🦺" },
        { "type": "text", "id": "title", "label": "Title", "default": "Slide it over their head" },
        { "type": "textarea", "id": "text", "label": "Body", "default": "Let the collar opening rest naturally at the base of the neck." },
        { "type": "text", "id": "pill", "label": "Pill badge", "default": "Under a minute" }
      ]
    }
  ],
  "presets": [ { "name": "How to use steps" } ]
}
{% endschema %}
