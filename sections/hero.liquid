<header class="hero">
  <div class="wrap hero-grid">
    <div class="hero-heading">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h1>
    </div>
    <div class="hero-visual reveal">
      <div class="hero-panel">
        <svg class="paw-print" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true"><ellipse cx="50" cy="66" rx="26" ry="21"/><ellipse cx="22" cy="38" rx="10" ry="13" transform="rotate(-18 22 38)"/><ellipse cx="44" cy="24" rx="10" ry="13.5" transform="rotate(-6 44 24)"/><ellipse cx="68" cy="24" rx="10" ry="13.5" transform="rotate(6 68 24)"/><ellipse cx="88" cy="40" rx="10" ry="13" transform="rotate(18 88 40)"/></svg>
        <div class="product-frame">
          {%- if section.settings.image -%}
            <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" width="1000" height="1000" fetchpriority="high" />
          {%- else -%}
            <img src="{{ 'product-black.jpg' | asset_url }}" alt="A puppy wearing the black Furvago calming vest" width="1000" height="1000" fetchpriority="high" />
          {%- endif -%}
        </div>
        <span class="hero-tagchip">{{ section.settings.tagchip }}</span>
      </div>
    </div>
    <div class="hero-body">
      <p class="hero-lead">{{ section.settings.lead }}</p>
      <div class="hero-ctas">
        <a href="{{ section.settings.button1_link | default: routes.all_products_collection_url }}" class="btn btn-primary">{{ section.settings.button1_label }}</a>
        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="btn btn-outline">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      <div class="hero-badges">
        {%- for block in section.blocks -%}
          <span class="b" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}{{ block.settings.text }}</span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Furvago — the calming vest" },
    { "type": "text", "id": "heading", "label": "Heading (plain part)", "default": "When the world gets loud, this" },
    { "type": "text", "id": "heading_accent", "label": "Heading (rust accent part)", "default": "holds them steady." },
    { "type": "image_picker", "id": "image", "label": "Hero photo (falls back to the bundled black vest photo)" },
    { "type": "text", "id": "tagchip", "label": "Photo tag chip", "default": "Calming vest · Sizes XS–XL" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "A gentle, wrapped-hug pressure vest for the dogs who tremble through thunderstorms, panic at fireworks, and pace by the door the moment you leave." },
    { "type": "text", "id": "button1_label", "label": "Primary button label", "default": "Shop the vest" },
    { "type": "url", "id": "button1_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "See how it works" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Shipping truck" },
          { "value": "returns", "label": "Return arrow" },
          { "value": "pin", "label": "Teardrop" },
          { "value": "check", "label": "Checkmark" }
        ], "default": "truck" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" }
      ]
    }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
