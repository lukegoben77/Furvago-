<header class="hero">
  <div class="hero-media">
    {%- if section.settings.image -%}
      <img
        class="hero-bg"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w,
                {{ section.settings.image | image_url: width: 1800 }} 1800w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="2400" height="1500"
        style="--hero-focal:{{ section.settings.image_position | default: 'center 32%' }};"
        fetchpriority="high"
      />
    {%- else -%}
      <img
        class="hero-bg"
        src="{{ 'product-black.jpg' | asset_url }}"
        alt="A puppy wearing the black Furvago calming vest"
        style="--hero-focal:{{ section.settings.image_position | default: 'center 32%' }};"
        fetchpriority="high"
      />
    {%- endif -%}
    <div class="hero-scrim"></div>
  </div>
  <div class="wrap hero-overlay align-{{ section.settings.text_position }}">
    <div class="hero-copy reveal">
      <p class="eyebrow on-dark">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h1>
      <p class="hero-lead">{{ section.settings.lead }}</p>
      <div class="hero-ctas">
        <a href="{{ section.settings.button1_link | default: routes.all_products_collection_url }}" class="btn btn-primary">{{ section.settings.button1_label }}</a>
        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="btn btn-ghost-light">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="hero-badges">
          {%- for block in section.blocks -%}
            <span class="b" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}{{ block.settings.text }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Furvago — the calming vest" },
    { "type": "text", "id": "heading", "label": "Heading (plain part)", "default": "When the world gets loud, this" },
    { "type": "text", "id": "heading_accent", "label": "Heading (rust accent part)", "default": "holds them steady." },
    { "type": "image_picker", "id": "image", "label": "Hero photo", "info": "Full-bleed background — wants a lifestyle/atmosphere shot, not a flat studio product photo. Falls back to the bundled black vest photo if empty." },
    { "type": "text", "id": "image_position", "label": "Image focal point (CSS object-position)", "info": "e.g. \"center 32%\" — nudge this so the subject isn't hidden behind the text overlay or cropped awkwardly on mobile.", "default": "center 32%" },
    { "type": "select", "id": "text_position", "label": "Text position", "options": [
      { "value": "left", "label": "Left-aligned, lower third (recommended)" },
      { "value": "center", "label": "Centered" }
    ], "default": "left" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "A gentle, wrapped-hug pressure vest for the dogs who tremble through thunderstorms, panic at fireworks, and pace by the door the moment you leave." },
    { "type": "text", "id": "button1_label", "label": "Primary button label", "default": "Shop the vest" },
    { "type": "url", "id": "button1_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "See how it works" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Shipping truck" },
          { "value": "returns", "label": "Return arrow" },
          { "value": "pin", "label": "Teardrop" },
          { "value": "check", "label": "Checkmark" }
        ], "default": "truck" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" }
      ]
    }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
